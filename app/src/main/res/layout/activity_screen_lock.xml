<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#020617"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="32dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="儿童观看时长已到达上限"
        android:textColor="#F43F5E"
        android:textSize="32sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="请让眼睛休息一下吧！家长请输入4位PIN码解锁："
        android:textColor="#E2E8F0"
        android:textSize="20sp" />

    <!-- PIN 码显示框 -->
    <TextView
        android:id="@+id/tv_pin_display"
        android:layout_width="260dp"
        android:layout_height="60dp"
        android:layout_marginTop="24dp"
        android:background="#1E293B"
        android:gravity="center"
        android:letterSpacing="0.4"
        android:text="----"
        android:textColor="#38BDF8"
        android:textSize="36sp"
        android:textStyle="bold" />

    <!-- 遥控器大号数字键九宫格 -->
    <GridLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:columnCount="3">

        <Button android:id="@+id/btn_1" style="@style/PinKeyStyle" android:text="1" />
        <Button android:id="@+id/btn_2" style="@style/PinKeyStyle" android:text="2" />
        <Button android:id="@+id/btn_3" style="@style/PinKeyStyle" android:text="3" />
        <Button android:id="@+id/btn_4" style="@style/PinKeyStyle" android:text="4" />
        <Button android:id="@+id/btn_5" style="@style/PinKeyStyle" android:text="5" />
        <Button android:id="@+id/btn_6" style="@style/PinKeyStyle" android:text="6" />
        <Button android:id="@+id/btn_7" style="@style/PinKeyStyle" android:text="7" />
        <Button android:id="@+id/btn_8" style="@style/PinKeyStyle" android:text="8" />
        <Button android:id="@+id/btn_9" style="@style/PinKeyStyle" android:text="9" />
        <Button android:id="@+id/btn_clear" style="@style/PinKeyStyle" android:text="清除" />
        <Button android:id="@+id/btn_0" style="@style/PinKeyStyle" android:text="0" />
        <Button android:id="@+id/btn_unlock" style="@style/PinKeyStyle" android:text="解锁" />

    </GridLayout>

</LinearLayout>
