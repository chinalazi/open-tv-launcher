<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_root">

    <!-- 家长验证层 -->
    <LinearLayout
        android:id="@+id/gate_layer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_gate_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="家长验证"
            android:textColor="@color/text_primary"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_gate_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="16dp"
            android:text="请输入 4 位家长 PIN 码"
            android:textColor="@color/text_secondary"
            android:textSize="18sp" />

        <com.openlauncher.tv.ui.common.PinPad
            android:id="@+id/gate_pad"
            android:layout_width="420dp"
            android:layout_height="wrap_content" />

    </LinearLayout>

    <!-- 设置内容层 -->
    <ScrollView
        android:id="@+id/content_layer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="48dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="儿童模式与防沉迷"
                android:textColor="@color/text_primary"
                android:textSize="26sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="启用儿童防沉迷模式"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp" />

                <Switch
                    android:id="@+id/switch_kids_mode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

            </LinearLayout>

            <TextView
                android:id="@+id/tv_limit_summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textColor="@color/text_accent"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tv_pin_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/text_secondary"
                android:textSize="16sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="单次观看时长"
                android:textColor="@color/text_secondary"
                android:textSize="16sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_single_15"
                    style="@style/SettingsButton"
                    android:text="15 分钟" />

                <Button
                    android:id="@+id/btn_single_30"
                    style="@style/SettingsButton"
                    android:text="30 分钟" />

                <Button
                    android:id="@+id/btn_single_45"
                    style="@style/SettingsButton"
                    android:text="45 分钟" />

                <Button
                    android:id="@+id/btn_single_60"
                    style="@style/SettingsButton"
                    android:text="60 分钟" />

            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="每日累计上限"
                android:textColor="@color/text_secondary"
                android:textSize="16sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_daily_60"
                    style="@style/SettingsButton"
                    android:text="1 小时" />

                <Button
                    android:id="@+id/btn_daily_120"
                    style="@style/SettingsButton"
                    android:text="2 小时" />

                <Button
                    android:id="@+id/btn_daily_180"
                    style="@style/SettingsButton"
                    android:text="3 小时" />

                <Button
                    android:id="@+id/btn_daily_240"
                    style="@style/SettingsButton"
                    android:text="4 小时" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_change_pin"
                    style="@style/SettingsButton"
                    android:text="修改家长 PIN" />

                <Button
                    android:id="@+id/btn_reset_today"
                    style="@style/SettingsButton"
                    android:text="重置今日计时" />

                <Button
                    android:id="@+id/btn_usage_access"
                    style="@style/SettingsButton"
                    android:text="白名单识别权限" />

            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:lineSpacingExtra="4dp"
                android:text="说明：白名单应用不计入时长。在桌面长按应用卡片可设为「允许儿童使用（不计时）」或隐藏。识别白名单需要授予「使用情况访问权限」，未授权时按亮屏时间统一计时。"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />

        </LinearLayout>
    </ScrollView>

</FrameLayout>
