<?xml version="1.0" encoding="utf-8"?>
<!-- 壁纸设置面板：遮罩全屏，卡片居中；选项胶囊和预览图由代码动态生成（见 WallpaperSettingsDialog） -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <View
        android:id="@+id/scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_dialog_scrim"
        android:clickable="true"
        android:focusable="false" />

    <LinearLayout
        android:id="@+id/sheet"
        android:layout_width="520dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_sheet_card"
        android:orientation="vertical"
        android:paddingStart="26dp"
        android:paddingTop="18dp"
        android:paddingEnd="26dp"
        android:paddingBottom="16dp">

        <!-- 标题 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.02"
                    android:text="壁纸设置"
                    android:textColor="@color/green_ink"
                    android:textSize="20sp" />

                <TextView
                    android:id="@+id/tv_sheet_sub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="选择图片种类与来源，开机自动使用"
                    android:textColor="#990F2E26"
                    android:textSize="12sp" />
            </LinearLayout>

            <FrameLayout
                android:id="@+id/btn_sheet_close"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/bg_chip"
                android:clickable="true"
                android:contentDescription="关闭"
                android:focusable="true"
                android:focusableInTouchMode="true">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_gravity="center"
                    android:duplicateParentState="true"
                    android:src="@drawable/ic_close"
                    android:tint="@color/chip_text" />
            </FrameLayout>
        </LinearLayout>

        <!-- 图片种类 -->
        <TextView
            style="@style/SheetLabel"
            android:text="图片种类" />

        <LinearLayout
            android:id="@+id/row_kind"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />

        <!-- 图片来源 -->
        <TextView
            style="@style/SheetLabel"
            android:text="图片来源" />

        <LinearLayout
            android:id="@+id/row_source_a"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />

        <LinearLayout
            android:id="@+id/row_source_b"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal" />

        <!-- 接口地址 -->
        <TextView
            style="@style/SheetLabel"
            android:text="接口地址" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_url_box"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingTop="10dp"
            android:paddingEnd="8dp"
            android:paddingBottom="10dp">

            <View
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:background="@drawable/bg_dot_green" />

            <TextView
                android:id="@+id/tv_endpoint"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:ellipsize="middle"
                android:fontFamily="monospace"
                android:maxLines="1"
                android:textColor="@color/green_ink_soft"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/btn_edit_url"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:background="@drawable/bg_chip"
                android:clickable="true"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="编辑"
                android:textColor="@color/chip_text"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- 预览 -->
        <TextView
            style="@style/SheetLabel"
            android:text="预览" />

        <LinearLayout
            android:id="@+id/row_thumbs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />

        <!-- 动作 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="end"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btn_shuffle"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:background="@drawable/bg_btn_ghost"
                android:clickable="true"
                android:drawablePadding="6dp"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:gravity="center"
                android:paddingStart="16dp"
                android:paddingEnd="18dp"
                android:text="立即换一张"
                android:textColor="@color/green_ink"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/btn_done"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_btn_primary"
                android:clickable="true"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:gravity="center"
                android:paddingStart="22dp"
                android:paddingEnd="22dp"
                android:text="完成"
                android:textColor="#FFFFFFFF"
                android:textSize="12sp" />
        </LinearLayout>

    </LinearLayout>

</FrameLayout>
