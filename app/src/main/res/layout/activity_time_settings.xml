<?xml version="1.0" encoding="utf-8"?>
<!-- 日期与时间（density 2.0，尺寸 = 设计值 / 2） -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_root">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="66dp"
        android:paddingTop="32dp"
        android:paddingEnd="66dp"
        android:paddingBottom="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif"
            android:includeFontPadding="false"
            android:letterSpacing="0.01"
            android:text="日期与时间"
            android:textColor="@color/text_primary"
            android:textSize="27dp" />

        <TextView
            android:id="@+id/tv_time_sub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:letterSpacing="0.05"
            android:text="桌面时钟 · 直接读系统时间"
            android:textColor="@color/text_secondary"
            android:textSize="10.5dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="bottom"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_now_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-light"
                android:includeFontPadding="false"
                android:letterSpacing="-0.02"
                android:textColor="@color/text_primary"
                android:textSize="38dp" />

            <TextView
                android:id="@+id/tv_now_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_marginBottom="5dp"
                android:letterSpacing="0.04"
                android:textColor="@color/text_secondary"
                android:textSize="11.5dp" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_marginTop="14dp"
            android:background="@color/min_line" />

        <!-- 只读信息：系统时间 vs 上次阿里校时的结果 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_min_row"
            android:orientation="vertical"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">

            <LinearLayout
                android:id="@+id/row_system_time"
                style="@style/TimeInfoRow">

                <TextView
                    style="@style/TimeInfoLabel"
                    android:text="系统时间" />

                <TextView
                    android:id="@+id/value_system_time"
                    style="@style/TimeInfoValue" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/row_ali_time"
                style="@style/TimeInfoRow">

                <TextView
                    style="@style/TimeInfoLabel"
                    android:text="阿里校时" />

                <TextView
                    android:id="@+id/value_ali_time"
                    style="@style/TimeInfoValue" />
            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btn_sync"
                style="@style/TimeAction"
                android:text="同步阿里时间" />

            <TextView
                android:id="@+id/btn_follow_system"
                style="@style/TimeAction"
                android:text="跟随系统" />

        </LinearLayout>

        <TextView
            android:id="@+id/tv_time_hint"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="12dp"
            android:layout_weight="1"
            android:lineSpacingExtra="3dp"
            android:textColor="@color/text_secondary"
            android:textSize="10dp" />

    </LinearLayout>

</FrameLayout>
