<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_lock"
    android:clickable="true"
    android:focusable="true">

    <com.openlauncher.tv.ui.common.AmbientBackdropView
        android:id="@+id/ambient_backdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_vignette" />

    <LinearLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="62dp"
        android:paddingTop="38dp"
        android:paddingEnd="62dp"
        android:paddingBottom="38dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_lock_meta"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:letterSpacing="0.08"
                android:text="儿童模式"
                android:textColor="#9EFFFFFF"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tv_lock_clock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.08"
                android:text=""
                android:textColor="#9EFFFFFF"
                android:textSize="12sp" />

        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:id="@+id/lock_card"
                android:layout_width="480dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:background="@drawable/bg_lock_card"
                android:elevation="24dp"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingStart="32dp"
                android:paddingTop="30dp"
                android:paddingEnd="32dp"
                android:paddingBottom="24dp">

                <TextView
                    android:id="@+id/tv_lock_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="本次观看时间已用完"
                    android:textColor="@color/status_warn"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_lock_hint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:lineSpacingExtra="3dp"
                    android:text="请让眼睛休息一下，家长输入 4 位 PIN 码继续"
                    android:textColor="#B8FFFFFF"
                    android:textSize="13sp" />

                <com.openlauncher.tv.ui.common.PinPad
                    android:id="@+id/pin_pad"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp" />

                <LinearLayout
                    android:id="@+id/lock_actions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/btn_lock_extra"
                        android:layout_width="0dp"
                        android:layout_height="46dp"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_btn_primary_selector"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:gravity="center"
                        android:text="再加 30 分钟"
                        android:textColor="@color/text_on_light"
                        android:textSize="13.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btn_lock_unlimited"
                        android:layout_width="0dp"
                        android:layout_height="46dp"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_btn_ghost_selector"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:gravity="center"
                        android:text="今日不再限制"
                        android:textColor="@color/text_primary"
                        android:textSize="13.5sp" />

                </LinearLayout>

                <TextView
                    android:id="@+id/tv_lock_tip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="时间到后请让眼睛休息，单次上限与每日上限可在家长设置中调整"
                    android:textColor="#6BFFFFFF"
                    android:textSize="11sp" />

            </LinearLayout>

        </FrameLayout>

    </LinearLayout>

</FrameLayout>
