<?xml version="1.0" encoding="utf-8"?>
<!-- 极简主页：一个大时钟、一排入口圆钮、一屏应用宫格，没有别的装饰。
     电视 density 是 320（2.0x），设计稿按 1920px 画，所以这里所有尺寸 = 设计值 / 2 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_root">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="66dp"
        android:paddingTop="35dp"
        android:paddingEnd="66dp"
        android:paddingBottom="28dp">

        <!-- ============ 顶栏：时间 / 三个入口 ============ -->
        <LinearLayout
            android:id="@+id/top_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/clock_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-light"
                    android:includeFontPadding="false"
                    android:letterSpacing="-0.02"
                    android:text="--:--"
                    android:textColor="@color/text_primary"
                    android:textSize="40dp" />

                <TextView
                    android:id="@+id/clock_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:includeFontPadding="false"
                    android:letterSpacing="0.06"
                    android:textColor="@color/text_secondary"
                    android:textSize="12dp" />

            </LinearLayout>

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <FrameLayout
                android:id="@+id/btn_network"
                android:layout_width="31dp"
                android:layout_height="31dp"
                android:layout_marginEnd="7dp"
                android:background="@drawable/bg_min_btn"
                android:clickable="true"
                android:contentDescription="网络连接"
                android:focusable="true"
                android:focusableInTouchMode="true">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_gravity="center"
                    android:contentDescription="网络连接"
                    android:duplicateParentState="true"
                    android:src="@drawable/ic_wifi"
                    android:tint="@color/accent" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/btn_all_apps"
                android:layout_width="31dp"
                android:layout_height="31dp"
                android:layout_marginEnd="7dp"
                android:background="@drawable/bg_min_btn"
                android:clickable="true"
                android:contentDescription="全部应用"
                android:focusable="true"
                android:focusableInTouchMode="true">

                <ImageView
                    android:layout_width="13dp"
                    android:layout_height="13dp"
                    android:layout_gravity="center"
                    android:contentDescription="全部应用"
                    android:duplicateParentState="true"
                    android:src="@drawable/ic_grid9"
                    android:tint="@color/icon_min" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/btn_settings"
                android:layout_width="31dp"
                android:layout_height="31dp"
                android:background="@drawable/bg_min_btn"
                android:clickable="true"
                android:contentDescription="设置"
                android:focusable="true"
                android:focusableInTouchMode="true">

                <ImageView
                    android:layout_width="13dp"
                    android:layout_height="13dp"
                    android:layout_gravity="center"
                    android:contentDescription="设置"
                    android:duplicateParentState="true"
                    android:src="@drawable/ic_gear"
                    android:tint="@color/icon_min" />
            </FrameLayout>

        </LinearLayout>

        <!-- ============ 应用宫格（6 列，自动分行） ============ -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <com.openlauncher.tv.ui.home.AppGridLayout
                android:id="@+id/app_grid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center" />

        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="方向键选择 · 确定打开 · 菜单键设置"
            android:textColor="#5E7168"
            android:textSize="11dp" />

    </LinearLayout>

</FrameLayout>
