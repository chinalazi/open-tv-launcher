<?xml version="1.0" encoding="utf-8"?>
<!-- 画框右上角的壁纸设置齿轮：默认白底绿图标，聚焦整体变绿反白 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="oval">
            <solid android:color="#12B57F" />
            <stroke android:width="3dp" android:color="#59FFFFFF" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="#EBFFFFFF" />
            <stroke android:width="1dp" android:color="#F2FFFFFF" />
        </shape>
    </item>
</selector>
