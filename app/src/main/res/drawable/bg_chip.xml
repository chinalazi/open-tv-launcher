<?xml version="1.0" encoding="utf-8"?>
<!-- 选项胶囊：选中=实心绿，聚焦=白底绿框，选中且聚焦=绿底白圈（电视上必须有明显焦点） -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true" android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="999dp" />
            <solid android:color="#12B57F" />
            <stroke android:width="3dp" android:color="#FFFFFFFF" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <corners android:radius="999dp" />
            <solid android:color="#12B57F" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="999dp" />
            <solid android:color="#FFFFFF" />
            <stroke android:width="2dp" android:color="#12B57F" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="999dp" />
            <solid android:color="#0F0F2E26" />
            <stroke android:width="1dp" android:color="#1A0F2E26" />
        </shape>
    </item>
</selector>
