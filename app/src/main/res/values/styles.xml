<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.OpenTVLauncher" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/bg_root</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:colorBackground">@color/bg_root</item>
        <item name="colorAccent">@color/accent</item>
    </style>

    <style name="Theme.OpenTVLauncher.Settings" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/bg_root</item>
        <item name="android:colorBackground">@color/bg_root</item>
        <item name="colorAccent">@color/accent</item>
    </style>

    <!-- 设置页的胶囊按钮：默认深灰，聚焦时反白（电视上焦点最直观） -->
    <style name="SettingsButton" parent="Widget.AppCompat.Button">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">54dp</item>
        <item name="android:layout_marginEnd">12dp</item>
        <item name="android:paddingStart">22dp</item>
        <item name="android:paddingEnd">22dp</item>
        <item name="android:background">@drawable/bg_pill</item>
        <item name="android:textColor">@color/btn_text</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <!-- 桌面长按 / 分类管理用的深色对话框，跟 Apple TV 的观感一致 -->
    <style name="DialogDark" parent="Theme.AppCompat.Dialog.Alert">
        <item name="android:windowBackground">@drawable/bg_dialog</item>
        <item name="android:backgroundDimAmount">0.72</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="colorAccent">@color/accent</item>
    </style>

</resources>
