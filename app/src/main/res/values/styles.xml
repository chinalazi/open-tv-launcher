<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.OpenTVLauncher" parent="Theme.Leanback">
        <item name="android:windowBackground">@color/bg_root</item>
    </style>

    <style name="Theme.OpenTVLauncher.Settings" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/bg_root</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="Theme.OpenTVLauncher.LockScreen" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/bg_lock</item>
        <item name="android:windowFullscreen">true</item>
    </style>

    <style name="SettingsButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginEnd">12dp</item>
        <item name="android:paddingStart">18dp</item>
        <item name="android:paddingEnd">18dp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:backgroundTint">@color/pin_key_bg</item>
    </style>

</resources>
