<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.OpenTVLauncher" parent="Theme.Leanback">
        <item name="android:windowBackground">@color/bg_root</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <style name="Theme.OpenTVLauncher.Settings" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/bg_root</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="Theme.OpenTVLauncher.LockScreen" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/bg_lock</item>
        <item name="android:windowFullscreen">true</item>
    </style>

    <!-- 全屏页面（全部应用） -->
    <style name="Theme.OpenTVLauncher.Fullscreen" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/bg_root</item>
        <item name="android:windowFullscreen">true</item>
    </style>

    <!-- 玻璃菜单弹窗 -->
    <style name="Theme.OpenTVLauncher.Dialog" parent="Theme.AppCompat.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:backgroundDimAmount">0.7</item>
    </style>

    <style name="SettingsButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginEnd">12dp</item>
        <item name="android:paddingStart">18dp</item>
        <item name="android:paddingEnd">18dp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:backgroundTint">@color/pin_key_bg</item>
    </style>

</resources>
